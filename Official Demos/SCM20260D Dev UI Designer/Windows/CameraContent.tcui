<!-- Ported from CameraWindow: the static layout only. The status TextFlow's text runs are driven at
     runtime by CameraWindow (which hosts this fragment in the ApplicationWindow navigation), and the live
     camera frames are drawn straight to the display in code (not a control here). TestButton sits at the
     bottom-left (Height - 30*3/2 = 227 for a 272-tall screen). -->
<Canvas Class="Demos.CameraContent" Width="480" Height="272">
  <TextFlow Name="StatusText" Canvas.Left="5" Canvas.Top="40" />
  <Button Name="TestButton" Width="100" Height="30" Canvas.Left="5" Canvas.Top="227">
    <Text TextContent="Test" Font="droid_reg11" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Button>
</Canvas>
